# Demo mode: true forces the fully cached fallback (zero network/model/CLI calls).
UMBRA_DEMO_MODE=false

# --- Live mode on Codex credits alone (no OpenAI API key required) ---
# The Codex CLI (authenticated via `codex login`, ChatGPT) runs a GPT-5.6 model
# and serves BOTH halves: engineering (disposable-checkout edits) and reasoning.
UMBRA_ENABLE_LIVE_REPOS=false   # true lets agents clone public repos
UMBRA_ENABLE_CODEX_CLI=false    # true lets agents run `codex exec`

# --- Optional ---
# Only needed if you have an entitled Responses API key; when absent, reasoning
# falls back to the Codex CLI and is honestly labelled `codex-cli` in the ledger.
OPENAI_API_KEY=
GITHUB_TOKEN=                   # OPTIONAL, read-only: a ZERO-scope token just raises the rate limit
                                # on public commit/diff reads. No repo access needed; never passed to Codex.
OSV_API_BASE=https://api.osv.dev/v1

# --- Sign-in + per-user dashboard (OAuth) ---
# Cloud "data-only" scans: run Watchman/Detective/Ask on real repos WITHOUT the
# Codex CLI (findings real; Codex diff + reasoning labelled unavailable).
UMBRA_ENABLE_CLOUD_SCAN=false
SESSION_SECRET=                # long random string; signs the session cookie (prod: Secret Manager)
UMBRA_COOKIE_SECURE=true       # false for plain-http localhost dev
OAUTH_REDIRECT_BASE=http://localhost:8000   # where providers redirect back (this backend)
UMBRA_FRONTEND_ORIGIN=http://localhost:3000 # where to send the browser after login (same origin in prod)
GITHUB_CLIENT_ID=              # GitHub OAuth App / GitHub App
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=              # Google Cloud OAuth 2.0 client
GOOGLE_CLIENT_SECRET=
UMBRA_USE_FIRESTORE=false      # true in the cloud for durable per-user history

# --- ChatGPT plugin / GPT Action ---
UMBRA_PUBLIC_URL=              # absolute base for the plugin manifest links (e.g. https://umbra.engineer)

# --- Autonomy (hosted): install-once GitHub App PR auto-review ---
# A user installs the Umbra GitHub App once (any account/org, public or private
# repos) and every PR gets an advisory review comment — no per-repo webhook, no
# stored user token; the review is posted as the App via a short-lived installation
# token minted from the private key. When these are unset the App webhook returns
# 503 and the dashboard hides the install button (nothing else is affected).
GITHUB_APP_ID=                 # numeric App ID from the App's settings page
GITHUB_APP_SLUG=               # the App's URL slug, e.g. "umbra-engineer" (for the install link)
GITHUB_APP_WEBHOOK_SECRET=     # the webhook secret you set when creating the App (HMAC)
GITHUB_APP_PRIVATE_KEY=        # the App's RSA private key — raw PEM, or base64 of the PEM
                               # (secret; prod mounts it from Secret Manager). See docs/github-app.md.
