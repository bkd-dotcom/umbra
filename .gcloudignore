# Keep the Cloud Build upload small — the Dockerfile rebuilds these.
.git/
.venv/
**/__pycache__/
.pytest_cache/
*.pyc
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.env
frontend/.env.local
# Never upload local dev notes, signing keys, or captured receipts to the build context.
opencode.md
*.key
*.pem
umbra-signing-key*
*signing-key*
umbra-receipt*.json
live-*-receipt.json
