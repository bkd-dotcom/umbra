# Demo mode: true forces the fully cached fallback (zero network/model/CLI calls).
UMBRA_DEMO_MODE=false

# --- Live mode on Codex credits alone (no OpenAI API key required) ---
# The Codex CLI (authenticated via `codex login`, ChatGPT) runs a GPT-5.6 model
# and serves BOTH halves: engineering (disposable-checkout edits) and reasoning.
UMBRA_ENABLE_LIVE_REPOS=false   # true lets agents clone public repos
UMBRA_ENABLE_CODEX_CLI=false    # true lets agents run `codex exec`

# --- Optional ---
# Only needed if you have an entitled Responses API key; when absent, reasoning
# falls back to the Codex CLI and is honestly labelled `codex-cli` in the ledger.
OPENAI_API_KEY=
GITHUB_TOKEN=                   # read-only; never passed to the Codex child process
OSV_API_BASE=https://api.osv.dev/v1

# --- Sign-in + per-user dashboard (OAuth) ---
UMBRA_ENABLE_CLOUD_SCAN=false  # real findings without Codex (findings real; Codex diff/reasoning labelled unavailable)
SESSION_SECRET=                # long random string; signs the session cookie (prod: Secret Manager)
UMBRA_COOKIE_SECURE=true       # false for plain-http localhost dev
OAUTH_REDIRECT_BASE=http://localhost:8000
UMBRA_FRONTEND_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UMBRA_USE_FIRESTORE=false      # true in the cloud for durable per-user history

# --- Per-user secrets encryption + live-Codex gating ---
UMBRA_FERNET_KEY=              # urlsafe-base64 32-byte Fernet key; encrypts stored GitHub/OpenAI secrets (prod: Secret Manager)
UMBRA_FOUNDER_IDS=             # comma-separated provider:sub allowed to spend the server's Codex credits, e.g. github:12345
CODEX_HOME=                    # where the mounted founder codex login lives in the cloud image (e.g. /app/.codex)

# --- Scheduled scans + emailed morning reports (all optional) ---
UMBRA_CRON_KEY=                # shared secret sent in the X-Umbra-Cron-Key header by the scheduler (Cloud Scheduler) to authorize POST /api/cron/run-due-scans; unset = feature off (503)
RESEND_API_KEY=                # Resend API key for sending report emails; unset = scans still run + save, no email sent
UMBRA_EMAIL_FROM=Umbra <reports@umbra.engineer>   # From address (must be on a Resend-verified domain in prod)
UMBRA_APP_URL=                 # base URL report emails link back to (the dashboard); defaults to UMBRA_FRONTEND_ORIGIN
